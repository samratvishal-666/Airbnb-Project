<%- include('../partials/header') %>
    </head>

    <body>
        <%- include('../partials/nav') %>

        <header>
            <h1 class="text-6xl text-center mt-8 text-red-500 ">Airbnb</h1>
        </header>

        <main>
            <h2 class="text-center text-xl mt-10 text-red-400">Add Your Home</h2>

            <form action="/host/add-home" method="post">
                <input
                    class="p-1 h-8 border border-black block mx-auto mt-10 rounded-md placeholder:text-pink-800 focus:placeholder-gray-400"
                    type="text" placeholder="Enter Your Home Name" name="houseName">

                <input
                    class="p-1 h-8 border border-black block mx-auto mt-10 rounded-md placeholder:text-pink-800 focus:placeholder-gray-400"
                    type="text" placeholder="Price per night" name="price">
                    
                <input
                    class="p-1 h-8 border border-black block mx-auto mt-10 rounded-md placeholder:text-pink-800 focus:placeholder-gray-400"
                    type="text" placeholder="Location" name="location">
                
                <input
                    class="p-1 h-8 border border-black block mx-auto mt-10 rounded-md placeholder:text-pink-800 focus:placeholder-gray-400"
                    type="text" placeholder="Image URL" name="photoUrl">

                <input
                    class="border bg-gray-600  text-gray-300 p-1 block mx-auto mt-3 rounded-lg cursor-pointer hover:scale-50"
                    type="submit" value="Add Home">
            </form>
        </main>

    </body>

    </html>