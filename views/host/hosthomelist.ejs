<%- include('../partials/header') %>
    </head>

    <body>
        <header>
            <%- include('../partials/nav') %>
                <h1 class="text-4xl text-center mt-8 text-red-500">Host Airbnb Page</h1>
                <p class="w-80 border mt-7 border-red-100 mx-auto"></p>
        </header>

        <main class="container">
            <h2 class="text-lg mt-8 text-center text-red-500">Your Registered Homes:</h2>

            <div class="font-medium grid grid-cols-3 p-5">
                <% registeredhomes.forEach(home=>{ %>
                    <div
                        class="mx-auto mt-3 hover:-translate-y-2 duration-300 cursor-pointer hover:shadow-2xl transition-all w-80 bg-white rounded-2xl shadow-[0_10px_25px_rgba(0,0,0,0.25)] overflow-hidden">
                        <img width="300px" height="50px" class=" max-w-sm rounded-lg ml-2 mt-4"
                        src="<%= home.photoUrl %>"
                        alt="%= home.houseName %">


                        <div class="text-red-500 ml-2 mt-2">
                            <%= home.houseName %>
                        </div>

                        <div class="text-red-500 ml-2 mt-2">

                            Rs.<%= home.price %>
                        </div>

                        <div class="text-red-500 ml-2 mt-2 flex justify-between">
                            <div>
                                <%= home.location %>
                            </div>
                            <div class="mr-2 flex">
                                ⭐
                                <%= home.rating %>
                            </div>
                        </div>

                        <div class="mb-2 flex gap-3">
                            <button class="ml-2 mt-2 px-4 py-1 bg-blue-500 rounded-full">Edit</button>
                            <button class="ml-2 mt-2 px-4 py-1 bg-red-500 rounded-full">Delete</button>
                        </div>
                    </div>
                    <% }) %>
            </div>
        </main>
    </body>

    </html>