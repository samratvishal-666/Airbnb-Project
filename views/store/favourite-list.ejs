<%- include('../partials/header') %>
    </head>

    <body>
        <header>
            <%- include('../partials/nav') %>
                <h1 class="text-4xl text-center mt-8 text-red-500">Welcome to Airbnb</h1>
                <p class="w-80 border mt-7 border-red-100 mx-auto"></p>
        </header>

        <main class="container">
            <h2 class="text-lg mt-8 text-center text-red-500">Your Favourites Home's:</h2>

            <div class="font-medium grid grid-cols-3 p-5">
                <% favouriteHomes.forEach(home=>{ %>
                    <div
                        class="mx-auto mt-3 hover:-translate-y-2 duration-300 cursor-pointer hover:shadow-2xl transition-all w-80 bg-white rounded-2xl shadow-[0_10px_25px_rgba(0,0,0,0.25)] overflow-hidden">
                        <img width="300px" height="50px" class=" max-w-sm rounded-lg ml-2 mt-4"
                            src="<%= home.photoUrl %>" alt="%= home.Url %">


                        <div class="text-red-500 ml-2 mt-2">
                            <%= home.houseName %>
                        </div>

                        <div class="text-red-500 ml-2 mt-2">

                            Rs.<%= home.price %>
                        </div>

                        <div class="text-red-500 ml-2 mt-2">

                            <%= home.location %>
                        </div>

                        <form action="/favourites/delete/<%= home.id %>" method="post">
                            <button class="ml-2 bg-red-500 px-3 py-1 mt-3 mb-3 hover:bg-red-700 rounded-lg">Remove from Favourites</button>
                        </form>
                    </div>
                    <% }) %>


            </div>
        </main>
    </body>

    </html>